diff --git a/src/renderer/metal.rs b/src/renderer/metal.rs
index 94b0af6..21d89eb 100644
--- a/src/renderer/metal.rs
+++ b/src/renderer/metal.rs
@@ -21,7 +21,7 @@ use winit::{event_loop::EventLoopProxy, window::Window};
 use crate::{
     platform::macos::get_ns_window,
     profiling::tracy_gpu_zone,
-    renderer::{RendererSettings, SkiaRenderer, VSync},
+    renderer::{RendererSettings, SkiaRenderer, VSync, vsync::VSyncMacosDisplayLink},
     window::EventPayload,
 };
 
@@ -199,7 +199,18 @@ impl SkiaRenderer for MetalSkiaRenderer {
         self.window.request_redraw();
     }
 
-    fn create_vsync(&self, _proxy: EventLoopProxy<EventPayload>) -> VSync {
-        VSync::MacosMetal()
+    fn create_vsync(&self, proxy: EventLoopProxy<EventPayload>) -> VSync {
+        // Pace rendering from the CVDisplayLink (like the OpenGL path) instead
+        // of relying on displaySyncEnabled back-pressure. With the passive
+        // VSync::MacosMetal() variant the only frame pacing is the blocking
+        // nextDrawable() call on the NSApp event thread; that block starves
+        // the run loop's event dequeue and macOS silently coalesces key
+        // autorepeats once dispatch latency exceeds roughly one frame,
+        // halving the effective key repeat rate mid-hold. Rendering right
+        // after the vsync tick means a drawable is already free, so
+        // nextDrawable() returns immediately and the event thread stays
+        // responsive; displaySyncEnabled stays on, so presentation remains
+        // aligned to refresh.
+        VSync::MacosDisplayLink(VSyncMacosDisplayLink::new(&self.window(), proxy))
     }
 }
