{
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git update-ref *)",
      "Bash(sudo *)",
      "Edit(~/.config/nvim/**)",
      "Edit(~/.local/share/neovide-patched/**)",
      "Edit(~/src/neovide/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Agent|Task|Workflow|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PROJECT_DIR}/preview/agent/hooks/guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PROJECT_DIR}/preview/agent/hooks/restore.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
